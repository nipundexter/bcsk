# Database — PostgreSQL. Local dev: run `npx prisma dev --name bcsk` and paste the URL it prints.
# Production (Vercel): create a Postgres database (Vercel dashboard → Storage → Neon) and use its URL.
DATABASE_URL="postgres://user:password@host:5432/bcsk?sslmode=require"
# SHADOW_DATABASE_URL is only needed for `prisma migrate dev` locally (provided by `npx prisma dev`)
SHADOW_DATABASE_URL=""

# Auth
JWT_SECRET="change-me-strong-random-secret"
SESSION_HOURS="8"

# Toss Payments sandbox (public documented test keys — replace with live keys in production)
TOSS_CLIENT_KEY="test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq"
TOSS_SECRET_KEY="test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R"

# SMTP (leave empty for simulated mode — emails are logged to /storage/outbox instead)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BCSK <bcskr22@gmail.com>"

# Zoom (leave empty for simulated mode — join links use the session's stored link)
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Google reCAPTCHA v2 (leave empty to disable check in dev)
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"
