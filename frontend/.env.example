# BCSK Frontend — copy to .env and adjust the URLs.
# UI only.
#
# Holds no secret and no database credentials. Everything it needs is a URL: the browser
# talks to NEXT_PUBLIC_API_BASE_URL, server rendering talks to BACKEND_API_URL, and the
# backend decides everything else.
#
# NODE_ENV is set by Next itself. PORT lives in the dev/start script. API_PREFIX and
# API_VERSION belong to the backend — they are baked into the URLs below.

BACKEND_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Public by design; the secret half stays in the backend (SEC-9).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# Demo login hints. Ignored entirely in production builds (SEC-2).
NEXT_PUBLIC_DEMO_MODE=""
