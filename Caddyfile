# One origin serves both: the web app at /, the API under /api.
#
# Same-origin keeps the web app's httpOnly session cookie working without any CORS at all —
# CORS then only matters for the mobile apps, which is exactly the smaller surface we want.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# The API. Stripping nothing: the backend already serves under the configured prefix.
	# API_PREFIX must match backend/.env — Caddy cannot read that file, so this is the one
	# place the value is repeated. Changing the prefix means changing both.
	handle /{$API_PREFIX:api}/* {
		reverse_proxy api:4000
	}

	# Swagger, restricted — an API description is a map of the attack surface.
	handle /{$API_PREFIX:api}/{$API_VERSION:v1}/docs* {
		@allowed remote_ip {$DOCS_ALLOWED_IPS:127.0.0.1/32}
		handle @allowed {
			reverse_proxy api:4000
		}
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	# The backend and Next both set their own security headers; these are the ones that
	# belong to the edge.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 10
		}
	}
}
